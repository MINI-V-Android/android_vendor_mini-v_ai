package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "htp_compute_test",
    vendor: true,
    srcs: ["main.cpp"],
    cflags: ["-Wno-error", "-fexceptions"],
    include_dirs: ["vendor/mini-v/ai/prebuilts/npu/include"],
    shared_libs: [
        "libggml-npu-prebuilt-linked",
        "libggml-base-npu-prebuilt-linked",
        "libggml-htp-npu-prebuilt-linked",
        "libggml-cpu-npu-prebuilt-linked",
    ],
}