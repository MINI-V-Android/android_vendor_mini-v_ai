package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "miniv_ai_defaults",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    cppflags: [
        "-std=c++20",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libcutils",
    ],
}

cc_prebuilt_library_static {
    name: "libllama-prebuilt",
    vendor: true,
    arch: {
        arm64: {
            srcs: ["prebuilts/arm64-v8a/libllama.a"],
        },
    },
    export_include_dirs: ["prebuilts/include"],
}

cc_prebuilt_library_static {
    name: "libggml-prebuilt",
    vendor: true,
    arch: {
        arm64: {
            srcs: ["prebuilts/arm64-v8a/libggml.a"],
        },
    },
    export_include_dirs: ["prebuilts/include"],
}

cc_prebuilt_library_static {
    name: "libggml-base-prebuilt",
    vendor: true,
    arch: {
        arm64: {
            srcs: ["prebuilts/arm64-v8a/libggml-base.a"],
        },
    },
    export_include_dirs: ["prebuilts/include"],
}

cc_prebuilt_library_static {
    name: "libggml-cpu-prebuilt",
    vendor: true,
    arch: {
        arm64: {
            srcs: ["prebuilts/arm64-v8a/libggml-cpu.a"],
        },
    },
    export_include_dirs: ["prebuilts/include"],
}