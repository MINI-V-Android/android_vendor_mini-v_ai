cc_library_static {
    name: "libnpu-engine-miniv",
    defaults: ["miniv_ai_defaults"],
    srcs: ["src/npu_llm_engine.cpp"],
    local_include_dirs: ["include"],
    include_dirs: ["vendor/mini-v/ai/prebuilts/npu/include"],
    shared_libs: ["libllama-npu-prebuilt-linked"],
}

cc_binary {
    name: "ai_daemon",
    defaults: ["miniv_ai_defaults"],

    srcs: [
        "main.cpp",
        "src/llm_engine.cpp",
        "src/session_manager.cpp",
        "src/hal_service.cpp",
    ],

    local_include_dirs: ["include"],

    static_libs: [
        "libllama-miniv",
        "vendor-miniv-ai-aidl-V1-ndk",
        "libnpu-engine-miniv",
    ],

    shared_libs: [
        "libbinder_ndk",
        "libllama-npu-prebuilt-linked",
    ],

    required: [
        "libggml-base-npu-prebuilt",
        "libggml-npu-prebuilt",
        "libggml-cpu-npu-prebuilt",
        "libggml-htp-npu-prebuilt",
        "libllama-npu-prebuilt",
        "libhtp-ops-npu-prebuilt",
        "libhtp-ops-skel-npu-prebuilt",
        // >>> MINI-V 추가 시작 (이슈 #40/#41 — libllama.so DT_NEEDED 재귀 체인
        // 표준경로 해석용, 전체 세트로 한 번에 커버)
        "libggml-base-npu-prebuilt-linked",
        "libggml-npu-prebuilt-linked",
        "libggml-cpu-npu-prebuilt-linked",
        "libggml-htp-npu-prebuilt-linked",
        "libllama-npu-prebuilt-linked",
        "libhtp-ops-npu-prebuilt-linked",
        // <<< MINI-V 추가 끝
    ],

    init_rc: ["etc/init.mini-v-ai.rc"],
}
