cc_binary {
    name: "ai_daemon",
    defaults: ["miniv_ai_defaults"],

    srcs: [
        "main.cpp",
        "src/llm_engine.cpp",
        "src/session_manager.cpp",
    ],

    local_include_dirs: ["include"],

    static_libs: [
        "libllama-miniv",
    ],

    init_rc: [
        "etc/init.mini-v-ai.rc",
    ],
}