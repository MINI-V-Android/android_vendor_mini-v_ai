package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "miniv_npu_prebuilt_defaults",
    vendor: true,
    check_elf_files: false,
    strip: { none: true },
}

// ── dlopen 스캔용 (miniv-npu/, ggml_backend_load_all_from_path 대상) ──
cc_prebuilt_library_shared {
    name: "libggml-base-npu-prebuilt",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libggml-base.so"],
    relative_install_path: "miniv-npu",
    stem: "libggml-base",
}
cc_prebuilt_library_shared {
    name: "libggml-npu-prebuilt",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libggml.so"],
    relative_install_path: "miniv-npu",
    stem: "libggml",
}
cc_prebuilt_library_shared {
    name: "libggml-cpu-npu-prebuilt",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libggml-cpu.so"],
    relative_install_path: "miniv-npu",
    stem: "libggml-cpu",
}
cc_prebuilt_library_shared {
    name: "libggml-htp-npu-prebuilt",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libggml-htp.so"],
    relative_install_path: "miniv-npu",
    stem: "libggml-htp",
}
cc_prebuilt_library_shared {
    name: "libhtp-ops-npu-prebuilt",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libhtp_ops.so"],
    relative_install_path: "miniv-npu",
    stem: "libhtp_ops",
}
cc_prebuilt_library_shared {
    name: "libllama-npu-prebuilt",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libllama.so"],
    relative_install_path: "miniv-npu",
    stem: "libllama",
}

// ── 표준 경로용 (/vendor/lib64/, DT_NEEDED 재귀 해석 대상 — 이슈 #40/#41) ──
// libllama.so가 이 체인(libggml → libggml-base, libggml-htp, ...)을
// 전부 DT_NEEDED로 직접 물고 있는 것으로 확인됨(실기기 CANNOT LINK 로그).
// dlopen 스캔용과 별개로, 6개 전부 표준 경로에도 중복 설치해 재귀 해석을
// 한 번에 끝냄. 동일 바이트(같은 srcs) + 동일 SONAME이라 런타임에 이미
// 로드된 인스턴스를 재사용하므로 중복 로드/심볼 충돌 없음.
cc_prebuilt_library_shared {
    name: "libggml-base-npu-prebuilt-linked",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libggml-base.so"],
    stem: "libggml-base",
}
cc_prebuilt_library_shared {
    name: "libggml-npu-prebuilt-linked",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libggml.so"],
    stem: "libggml",
}
cc_prebuilt_library_shared {
    name: "libggml-cpu-npu-prebuilt-linked",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libggml-cpu.so"],
    stem: "libggml-cpu",
}
cc_prebuilt_library_shared {
    name: "libggml-htp-npu-prebuilt-linked",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libggml-htp.so"],
    stem: "libggml-htp",
}
cc_prebuilt_library_shared {
    name: "libhtp-ops-npu-prebuilt-linked",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libhtp_ops.so"],
    stem: "libhtp_ops",
}
cc_prebuilt_library_shared {
    name: "libllama-npu-prebuilt-linked",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["lib64/libllama.so"],
    stem: "libllama",
}

// Q6DSP(Hexagon) ELF — 기존과 동일, 변경 없음
cc_prebuilt_library_shared {
    name: "libhtp-ops-skel-npu-prebuilt",
    defaults: ["miniv_npu_prebuilt_defaults"],
    srcs: ["dsp/libhtp_ops_skel.so"],
    relative_install_path: "rfsa/adsp",
    stem: "libhtp_ops_skel",
}